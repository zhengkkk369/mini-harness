# Credentials and local environments
.env
.env.*
.venv/
venv/
# A local config that carries credentials must never be committed: it holds an
# API key by design, and the repository's own settings all come from the
# environment (`MINI_HARNESS_*`), so nothing here needs this file to run.
config.yaml
config.local.yaml

# Python and tooling caches
__pycache__/
*.py[cod]
.cache/
.ruff_cache/
.pytest_cache/
.pytest-tmp/
.pytest-work/
.experiments/
pytest-cache-files-*/
.probe/
.pt2/
.tmp-alt/
.coverage
htmlcov/

# Build outputs
dist/
build/
*.egg-info/

# Local sessions, working files, and benchmark uploads
session.json
mini_harness_*.json
mini_harness_*.jsonl
sandbox/
.local/
jobs/
*.tar.gz
.DS_Store
